# ============================================================
# AI Trade — variables d'environnement
# Copie ce fichier en `.env` (backend Python) et renseigne les valeurs.
# Les champs marqués [REQUIS] sont indispensables au démarrage.
#
# Plus rapide, et sans copier-coller : `python scripts/generate_secrets.py` remplit
# dans `.env` les trois secrets que cette machine sait générer (WEBHOOK_SECRET,
# INTERNAL_API_KEY, ENCRYPTION_KEY) sans jamais les afficher, puis nomme les deux
# qui viennent d'un service externe. `--check` dit seulement ce qui manque.
# ============================================================

# --- Sécurité [REQUIS] ---
# Deux secrets DISTINCTS (le démarrage est refusé s'ils sont absents ou égaux).
WEBHOOK_SECRET="change-me-super-secret"
INTERNAL_API_KEY="change-me-internal-api-key"

# Clé Fernet de chiffrement des identifiants broker — c'est celle qui CHIFFRE.
# Génère-la avec : python scripts/generate_secrets.py
# (équivalent : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Le préfixe « vN: » est facultatif ; une clé nue vaut `v1:`. La version se lit
# dans le chiffré (`v2:<jeton>`), donc les lignes à tourner se comptent.
ENCRYPTION_KEY=""

# Clés RETIRÉES de l'anneau : elles ne servent qu'à rouvrir le chiffré écrit avec
# elles, jamais à chiffrer. C'est ce qui permet de tourner ENCRYPTION_KEY sans
# perdre les identifiants déjà en base — et ce qui rend la rotation terminable :
# quand `python scripts/rotate_encryption_key.py` ne trouve plus rien à réécrire,
# on retire la clé d'ici puis `python scripts/verify_secrets.py --record`.
# Format : `v1:<clé>,v2:<clé>`, la plus récente d'abord. Une entrée illisible, une
# version écrite deux fois ou une clé recopiée de la clé active font REFUSER le
# déploiement. Détail : docs/SECRETS.md, « ENCRYPTION_KEY ».
ENCRYPTION_KEYS_PREVIOUS=""

# --- Rotation des secrets (audit fail-closed en pre-deploy) ---
# Durée de vie maximale d'un secret avant rotation obligatoire (jours).
SECRET_MAX_AGE_DAYS="90"
# Chemin du registre de rotation (empreintes seules ; local à l'environnement).
SECRET_ROTATION_LEDGER="security/secret_rotation.json"

# URL du **service déployé** — le seul réglage de ce fichier qui ne soit pas un
# secret. Quand elle est renseignée, l'audit pre-deploy compare les empreintes de
# ce que le processus distant a chargé aux siennes (`GET /secrets/fingerprints`) :
# une valeur différente, un secret absent en production ou un service injoignable
# font REFUSER le déploiement. Sans elle, l'audit reste vert mais dit que la
# production n'a pas été vérifiée ; `--require-remote` en fait un refus.
#   python scripts/verify_secrets.py --remote https://<service>.onrender.com
DEPLOYED_URL=""

# --- Supabase [REQUIS] ---
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"

# --- Telegram [REQUIS] ---
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."

# Chat privé qui reçoit les comptes-rendus d'ingestion venus d'un CANAL où le bot
# est administrateur (route `channel_post`). Un canal ne se répond pas dans le
# canal : le message s'y publierait devant tous les abonnés. Ton id numérique
# (l'écrire `/start` au bot puis le lire dans les logs, ou via @userinfobot).
# Sans cette valeur, l'ingestion fonctionne quand même : seul l'admin qui a
# publié le message reçoit la revue, et une publication anonyme ne reçoit rien.
TELEGRAM_ADMIN_CHAT_ID=""

# --- Balayage des canaux Telegram (optionnel) ---
# Canaux publics lus via l'aperçu `t.me/s/<canal>`. Pseudos publics uniquement,
# séparés par des virgules (`@canal` et URL `https://t.me/<canal>` acceptés).
# Une valeur invalide est écartée en le disant ; un espace n'est pas un
# séparateur — un pseudo Telegram n'en contient jamais.
# ABSENT = canal par défaut du projet. VIDE = aucun balayage (c'est ainsi qu'on
# éteint la collecte sans toucher au code).
# Peut aussi être surchargé en base, table `bot_settings` (migration 010), pour
# changer la liste sans redéployer le worker — `database/settings.py`.
TELEGRAM_CHANNELS="thehalalwinningteam"

# Période de balayage de ces canaux, en minutes (30 par défaut, bornée à 5..1440 :
# en dessous on martèle l'aperçu public, au-dessus d'une journée le canal n'est
# plus vraiment suivi). Surchargeable en base de la même façon.
TELEGRAM_SCAN_MINUTES="30"

# Plafond d'extractions par canal et par balayage (10 par défaut, borné à
# 0..100). Un canal qui publie un album expose des dizaines de photos d'un coup :
# les extraire toutes dans le même passage consommerait le quota de vision
# (Gemini) ou de transcription (Groq) en une seule fois. Le surplus n'est pas
# perdu — il est reporté au balayage suivant, l'aperçu redonnant les mêmes
# publications. « 0 » = sans plafond. Surchargeable en base de la même façon.
TELEGRAM_SCAN_MAX_EXTRACTIONS="10"

# --- Veille média : réconciliation bucket ↔ `knowledge_media` (optionnel) ---
# L'auto-loop compte périodiquement les objets sans ligne (orphelins) et les
# tables décrites dont l'objet a disparu, puis alerte sur TELEGRAM_ADMIN_CHAT_ID
# au-delà du seuil. Elle ne supprime JAMAIS rien : le message nomme la commande
# (`python scripts/reconcile_media.py --delete`) et la réparation
# (`POST /admin/media/missing/repair`).
# 360 minutes par défaut, bornée à 30..1440 (le parcours fait deux listings
# complets du bucket) ; « 0 » éteint la veille. Surchargeable en base.
MEDIA_RECONCILE_MINUTES="360"

# Nombre d'objets orphelins STRICTEMENT au-dessus duquel on alerte. Un média
# dont l'objet a disparu alerte toujours, dès le premier : c'est l'application
# qui est cassée, pas seulement du stockage occupé. « 0 » = alerter dès le
# premier orphelin.
MEDIA_ORPHAN_ALERT_THRESHOLD="25"

# --- Veille Supabase en lecture seule (optionnel) ---
# L'auto-loop relance périodiquement `scripts/check_supabase.py` en LECTURE SEULE
# (roundtrip désactivé) et n'alerte que sur un CHANGEMENT de verdict : une
# vérification qui tombe, ou qui repasse au vert. Un état stable n'est pas
# réannoncé, sinon une base cassée alerterait à chaque passage. Le premier
# passage, lui, parle des échecs qu'il constate. L'alerte part sur
# TELEGRAM_ADMIN_CHAT_ID (le même que la veille média) ; sans lui, la veille le
# dit et n'adopte pas le verdict.
# 30 minutes par défaut, bornée à 5..1440 ; « 0 » éteint la veille. Surchargeable
# en base, table `bot_settings` (migration 010).
SUPABASE_WATCH_MINUTES="30"

# --- Alpaca (compte partagé optionnel — paper uniquement) ---
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""
ALPACA_BASE_URL="https://paper-api.alpaca.markets"

# --- LLM (au moins un des deux pour l'analyse de news) ---
# GROQ_API_KEY sert aussi à la transcription des vocaux (whisper-large-v3).
# Sans elle, `ai/media_extractor.py` retombe sur `faster-whisper` en local :
# installer le paquet **et** pré-télécharger les poids, sinon la transcription
# échouera (voir README, « Transcription sans Groq »).
GROQ_API_KEY=""
GEMINI_API_KEY=""

# --- Données de marché ---
FINNHUB_API_KEY=""

# --- Embeddings (recherche vectorielle Gemini) ---
# Réutilise GEMINI_API_KEY ci-dessus : aucun secret supplémentaire à gérer. Sans
# elle, la recherche vectorielle est désactivée et l'extrait fixe de
# `knowledge_base` est utilisé.
# Modèle d'embeddings — DOIT être un modèle Gemini produisant 768 dimensions
# (colonne `knowledge_chunks.embedding`). `gemini-embedding-2` est exclu : il
# agrège plusieurs textes en un seul vecteur.
EMBEDDING_MODEL="gemini-embedding-001"

# --- Synchronisation Obsidian (optionnel) ---
GITHUB_TOKEN=""
GITHUB_REPO=""
GITHUB_BRANCH="main"

# --- Réglages de risque (optionnel, valeurs par défaut entre parenthèses) ---
PAPER_TRADING="true"        # (true)
MIN_CONFIDENCE="0.55"       # (0.55)
DEFAULT_RISK_PCT="1.0"      # (1.0)
DEFAULT_PAPER_EQUITY="100000"  # (100000)
MIN_RISK_REWARD_RATIO="1.2" # (1.2)
MAX_POSITION_QTY="1000"     # (1000)

# --- Apprentissage adaptatif (optionnel) ---
# La descente de gradient est DÉSACTIVÉE par défaut : tant que ce flag est
# inactif, la recalibration heuristique d'origine reste le comportement
# nominal. L'activer fait apprendre les poids TA/sentiment/macro par descente
# de gradient sur les trades réglés (voir docs/ADAPTIVE_LEARNING.md).
ADAPTIVE_GD_ENABLED="false"    # (false)
ADAPTIVE_GD_MIN_SAMPLES="20"   # (20) trades réglés minimum par actif

# --- IDs de modèles LLM (optionnel, surchargeables) ---
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_LITE_MODEL="gemini-3.1-flash-lite"
GEMINI_PRO_MODEL="gemini-3.1-pro"
GROQ_PRIMARY_MODEL="openai/gpt-oss-120b"
GROQ_SECONDARY_MODEL="qwen/qwen3.6-27b"

# --- Android (BuildConfig.GEMINI_API_KEY via secrets gradle plugin) ---
# GEMINI_API_KEY est réutilisé côté app Android.
