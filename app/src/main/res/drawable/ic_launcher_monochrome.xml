<!--
  Couche « monochrome » de l'icône de lancement (Android 13 et suivants) : le
  système la teinte aux couleurs du fond d'écran, une seule couleur suffit donc.
  Trois barres ascendantes, comme le jeu de chandeliers de la couche
  `foreground`, mais simplifiées : à cette taille, un tracé fin disparaît.
  Tout le motif tient dans le cercle de 66 dp centré que les masques de
  lanceur conservent.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,74 h10 v-22 h-10 z M50,74 h10 v-32 h-10 z M62,74 h10 v-42 h-10 z" />
</vector>
